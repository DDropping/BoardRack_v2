# Copy to .env.local for development. In production these are set in the
# Vercel dashboard under Project Settings -> Environment Variables.

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. The Atlas cluster must allow connections
# from 0.0.0.0/0, because Vercel's serverless functions have no static IP.
MONGO_SRV=mongodb+srv://user:password@cluster.mongodb.net/boardrack?retryWrites=true&w=majority

# --- Auth -------------------------------------------------------------------
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

# --- AWS S3 -----------------------------------------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-west-1
S3_BUCKET=boardrack
# Public base URL for objects in the bucket, with no trailing slash.
# Used server-side when storing generated location maps.
S3_PUBLIC_URL=https://boardrack.s3.amazonaws.com
# Same value, exposed to the browser so uploaded image URLs can be built there.
NEXT_PUBLIC_S3_PUBLIC_URL=https://boardrack.s3.amazonaws.com

# --- Email (nodemailer) -----------------------------------------------------
# NOTE: Gmail removed "less secure app" passwords in 2022. If EMAIL_SERVICE is
# gmail, EMAIL_PASS must be an App Password generated with 2FA enabled.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# --- HERE (location services) -----------------------------------------------
# Requires a HERE project with Geocoding & Search v7 and Map Image v3 enabled.
HERE_API_KEY=

# --- Site URL ---------------------------------------------------------------
# Set once a custom domain is attached. If unset, the app falls back to
# NEXT_PUBLIC_VERCEL_URL (injected by Vercel), then to localhost.
NEXT_PUBLIC_SITE_URL=

# --- ipstack (optional) -----------------------------------------------------
# Only used when NOT deployed on Vercel; on Vercel the edge geolocation headers
# are used instead. https requires a paid ipstack plan.
IPSTACK_ACCESS_KEY=

# --- Support account (optional) ---------------------------------------------
# ObjectId of the user account that sends the welcome message on registration.
# Create that user first, then paste its _id here. If unset, registration still
# succeeds and the welcome message is skipped.
SUPPORT_USER_ID=
